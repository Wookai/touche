{
  "name": "touche",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p engine && tsc -p engine/test && tsc -p engine/bin && tsc -p web",
    "test": "vitest run",
    "sim": "npm run sim -w engine"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
